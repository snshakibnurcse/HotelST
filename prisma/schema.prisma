generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MANAGER
  INVESTOR
}

enum RoomStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
  MAINTENANCE
  OUT_OF_SERVICE
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  VOIDED
}

enum InvoiceItemType {
  ROOM_CHARGE
  EXTRA_GUEST
  FOOD_BEVERAGE
  LAUNDRY
  SERVICE
  DAMAGE
  OTHER
}

enum PaymentMethod {
  CASH
  BKASH
  NAGAD
  BANK_TRANSFER
  CARD_POS
  OTHER
}

enum TransactionType {
  INCOME
  EXPENSE
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  fullName     String
  phone        String?
  role         Role     @default(MANAGER)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  hotelAssignments    HotelUser[]
  investorAccess      InvestorHotelAccess[]
  createdReservations Reservation[]          @relation("ReservationCreator")
  createdInvoices     Invoice[]              @relation("InvoiceCreator")
  receivedPayments    Payment[]              @relation("PaymentReceiver")
  createdTransactions FinancialTransaction[] @relation("TransactionCreator")
  auditLogs           AuditLog[]

  @@map("users")
}

model Hotel {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  code         String   @unique
  address      String
  city         String
  state        String?
  country      String   @default("Bangladesh")
  postalCode   String?
  phone        String
  email        String
  website      String?
  logoUrl      String?
  starRating   Int      @default(3)
  checkInTime  String   @default("14:00")
  checkOutTime String   @default("12:00")
  currency     String   @default("BDT")
  taxRate      Decimal  @default(0.00) @db.Decimal(5, 2)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  managers              HotelUser[]
  investorAccess        InvestorHotelAccess[]
  roomTypes             RoomType[]
  rooms                 Room[]
  guests                Guest[]
  reservations          Reservation[]
  invoices              Invoice[]
  payments              Payment[]
  financialTransactions FinancialTransaction[]
  financialCategories   FinancialCategory[]
  settings              HotelSetting[]
  auditLogs             AuditLog[]

  @@map("hotels")
}

model HotelUser {
  id        String   @id @default(cuid())
  hotelId   String
  userId    String
  role      String   @default("MANAGER")
  createdAt DateTime @default(now())

  hotel Hotel @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([hotelId, userId])
  @@map("hotel_users")
}

model InvestorHotelAccess {
  id        String   @id @default(cuid())
  hotelId   String
  userId    String
  createdAt DateTime @default(now())

  hotel Hotel @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([hotelId, userId])
  @@map("investor_hotel_access")
}

model RoomType {
  id               String   @id @default(cuid())
  hotelId          String
  name             String
  code             String
  description      String?  @db.Text
  basePrice        Decimal  @db.Decimal(10, 2)
  maxAdults        Int      @default(2)
  maxChildren      Int      @default(1)
  totalBeds        Int      @default(1)
  bedConfiguration String   @default("1 King Bed")
  amenities        String?  @db.Text
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  hotel Hotel  @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  rooms Room[]

  @@unique([hotelId, code])
  @@map("room_types")
}

model Room {
  id          String     @id @default(cuid())
  hotelId     String
  roomTypeId  String
  roomNumber  String
  floor       String     @default("1")
  status      RoomStatus @default(AVAILABLE)
  isClean     Boolean    @default(true)
  isArchived  Boolean    @default(false)
  description String?    @db.Text
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  hotel        Hotel         @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  roomType     RoomType      @relation(fields: [roomTypeId], references: [id], onDelete: Restrict)
  reservations Reservation[]

  @@unique([hotelId, roomNumber])
  @@index([hotelId, status, isArchived])
  @@map("rooms")
}

model Guest {
  id               String   @id @default(cuid())
  hotelId          String
  fullName         String
  mobile           String
  email            String?
  nidPassport      String?
  address          String?
  city             String?
  country          String?  @default("Bangladesh")
  nationality      String?  @default("Bangladeshi")
  emergencyContact String?
  notes            String?  @db.Text
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  hotel        Hotel         @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  reservations Reservation[]
  invoices     Invoice[]

  @@index([hotelId, mobile])
  @@index([hotelId, fullName])
  @@index([hotelId, nidPassport])
  @@map("guests")
}

model Reservation {
  id                  String            @id @default(cuid())
  reservationNumber   String            @unique
  hotelId             String
  roomId              String
  guestId             String
  bookingSource       String            @default("WALK_IN")
  checkInDate         DateTime          @db.Date
  checkOutDate        DateTime          @db.Date
  actualCheckIn       DateTime?
  actualCheckOut      DateTime?
  status              ReservationStatus @default(CONFIRMED)
  adultCount          Int               @default(1)
  childCount          Int               @default(0)
  nightlyRateSnapshot Decimal           @db.Decimal(10, 2)
  totalNights         Int
  roomCharges         Decimal           @db.Decimal(10, 2)
  discountAmount      Decimal           @default(0.00) @db.Decimal(10, 2)
  taxAmount           Decimal           @default(0.00) @db.Decimal(10, 2)
  additionalCharges   Decimal           @default(0.00) @db.Decimal(10, 2)
  totalAmount         Decimal           @db.Decimal(10, 2)
  advancePaid         Decimal           @default(0.00) @db.Decimal(10, 2)
  paidAmount          Decimal           @default(0.00) @db.Decimal(10, 2)
  outstandingBalance  Decimal           @db.Decimal(10, 2)
  specialRequests     String?           @db.Text
  cancellationReason  String?           @db.Text
  createdById         String?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  hotel     Hotel     @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  room      Room      @relation(fields: [roomId], references: [id], onDelete: Restrict)
  guest     Guest     @relation(fields: [guestId], references: [id], onDelete: Restrict)
  createdBy User?     @relation("ReservationCreator", fields: [createdById], references: [id], onDelete: SetNull)
  invoices  Invoice[]
  payments  Payment[]

  @@index([hotelId, checkInDate, checkOutDate])
  @@index([hotelId, roomId, status])
  @@map("reservations")
}

model Invoice {
  id                 String        @id @default(cuid())
  invoiceNumber      String        @unique
  hotelId            String
  reservationId      String?
  guestId            String
  issueDate          DateTime      @default(now())
  dueDate            DateTime?
  subtotal           Decimal       @db.Decimal(10, 2)
  discountAmount     Decimal       @default(0.00) @db.Decimal(10, 2)
  taxAmount          Decimal       @default(0.00) @db.Decimal(10, 2)
  additionalCharges  Decimal       @default(0.00) @db.Decimal(10, 2)
  totalAmount        Decimal       @db.Decimal(10, 2)
  paidAmount         Decimal       @default(0.00) @db.Decimal(10, 2)
  outstandingBalance Decimal       @db.Decimal(10, 2)
  status             InvoiceStatus @default(ISSUED)
  notes              String?       @db.Text
  createdById        String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  hotel       Hotel         @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  reservation Reservation?  @relation(fields: [reservationId], references: [id], onDelete: SetNull)
  guest       Guest         @relation(fields: [guestId], references: [id], onDelete: Restrict)
  createdBy   User?         @relation("InvoiceCreator", fields: [createdById], references: [id], onDelete: SetNull)
  items       InvoiceItem[]
  payments    Payment[]

  @@index([hotelId, issueDate])
  @@index([hotelId, status])
  @@map("invoices")
}

model InvoiceItem {
  id          String          @id @default(cuid())
  invoiceId   String
  description String
  type        InvoiceItemType @default(ROOM_CHARGE)
  quantity    Int             @default(1)
  unitPrice   Decimal         @db.Decimal(10, 2)
  totalPrice  Decimal         @db.Decimal(10, 2)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("invoice_items")
}

model Payment {
  id             String        @id @default(cuid())
  paymentNumber  String        @unique
  hotelId        String
  invoiceId      String?
  reservationId  String?
  amount         Decimal       @db.Decimal(10, 2)
  method         PaymentMethod @default(CASH)
  transactionRef String?
  paymentDate    DateTime      @default(now())
  notes          String?
  receivedById   String?
  createdAt      DateTime      @default(now())

  hotel       Hotel        @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  invoice     Invoice?     @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  reservation Reservation? @relation(fields: [reservationId], references: [id], onDelete: SetNull)
  receivedBy  User?        @relation("PaymentReceiver", fields: [receivedById], references: [id], onDelete: SetNull)

  @@index([hotelId, paymentDate])
  @@map("payments")
}

model FinancialCategory {
  id          String          @id @default(cuid())
  hotelId     String?
  name        String
  type        TransactionType
  isSystem    Boolean         @default(false)
  description String?

  hotel        Hotel?                 @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  transactions FinancialTransaction[]

  @@unique([hotelId, name, type])
  @@map("financial_categories")
}

model FinancialTransaction {
  id                String          @id @default(cuid())
  transactionNumber String          @unique
  hotelId           String
  categoryId        String
  type              TransactionType
  amount            Decimal         @db.Decimal(10, 2)
  transactionDate   DateTime
  description       String
  reference         String?
  receiptUrl        String?
  paymentMethod     PaymentMethod   @default(CASH)
  createdById       String?
  isReversed        Boolean         @default(false)
  reversalReason    String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  hotel     Hotel             @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  category  FinancialCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  createdBy User?             @relation("TransactionCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([hotelId, transactionDate, type])
  @@map("financial_transactions")
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  hotelId    String?
  action     String
  entityType String
  entityId   String?
  metadata   String?  @db.Text
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  actor User?  @relation(fields: [actorId], references: [id], onDelete: SetNull)
  hotel Hotel? @relation(fields: [hotelId], references: [id], onDelete: SetNull)

  @@index([hotelId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

model HotelSetting {
  id           String   @id @default(cuid())
  hotelId      String
  settingKey   String
  settingValue String   @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  hotel Hotel @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  @@unique([hotelId, settingKey])
  @@map("hotel_settings")
}
